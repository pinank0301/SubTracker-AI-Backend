# ==============================================================================
# SubTracker Microservices Platform — Environment Variables Template
# Copy this file to .env and configure with your actual deployment values:
#   cp .env.example .env
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For PostgreSQL running on the same EC2 host (outside Docker), use:
#   host.docker.internal:5432
# For AWS RDS or external managed PostgreSQL, use:
#   your-rds-endpoint.amazonaws.com:5432
AUTH_DB_URL=jdbc:postgresql://host.docker.internal:5432/authdb
SUBSCRIPTION_DB_URL=jdbc:postgresql://host.docker.internal:5432/subscriptiondb
NOTIFICATION_DB_URL=jdbc:postgresql://host.docker.internal:5432/notificationdb
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------------------------
# 256-bit / 64-hex-character secret key shared between api-gateway & auth-service
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=3600000

# ------------------------------------------------------------------------------
# 3. External Python AI Agent Service (Hosted on Render)
# ------------------------------------------------------------------------------
AI_AGENT_SERVICE_URL=https://subtracker-ai-agent.onrender.com

# ------------------------------------------------------------------------------
# 4. Service Discovery (Eureka)
# ------------------------------------------------------------------------------
# Inside Docker Compose, this points to the internal discovery-server container
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/

# ------------------------------------------------------------------------------
# 5. Mail Configuration (notification-service)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
SPRING_MAIL_FROM_ADDRESS=your_email@gmail.com

# ------------------------------------------------------------------------------
# 6. Host Port Bindings
# ------------------------------------------------------------------------------
# Main entrypoint exposed to the host / reverse proxy
GATEWAY_PORT=8080

# Optional: Eureka server dashboard port exposed to host for debugging (default: 8761)
DISCOVERY_PORT=8761

# ------------------------------------------------------------------------------
# 7. JVM Memory Settings (Tuned for small single EC2 instances)
# ------------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx384m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
